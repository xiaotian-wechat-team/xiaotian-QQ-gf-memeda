# Local runtime config (copy from config.example.json)
config.json

# =============================================================================
# xiaotian-wechat .gitignore
# config.example.json 可保留演示模型名；本地 config.json、密钥与运行时文件勿提交。
# Keep demo model names in config.example.json; never commit local secrets or runtime state.
# =============================================================================

# ----- 通用 / general -----
__pycache__/
.venv/
.venv
tmp/

# ----- 密钥 secrets（API keys / tokens；勿提交真实 *.env）-----
# Catch-all for local env files; *.env.example stays trackable (different suffix).
config/*.env
# 发言 LLM chat keys
#   config/deepseek.env   — DeepSeek short_backend
#   config/kimi.env       — Kimi short_backend
#   config/doubao.env     — Doubao/Volcengine Ark chat (ARK_API_KEY)
# 生图 / Magpie（发言 grok 适配器亦读此文件）
#   config/magpie.env     — MAGPIE_API_KEY / MAGPIE_LAN_KEY
# 语音 TTS
#   config/doubao_voice.env — Doubao voice APP_ID / ACCESS_TOKEN / API_KEY
# 其它
#   config/relay.env      — relay webhook
config/relay.env
config/deepseek.env
config/kimi.env
config/doubao.env
config/doubao_voice.env
config/magpie.env
tools/napcat/.env

